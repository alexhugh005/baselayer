  "scenes": [
    {
      "title": "1. Turn on Grid outage - battery backup",
      "start": 1790452493970,
      "end": 1790452499206
    },
    {
      "title": "Wait for Backup ready: On. All circuits are now off.",
      "start": 1790452525213,
      "end": 1790452527802
    },
    {
      "title": "1. Start the outage\nTurn on Grid outage - battery backup.",
      "start": 1790452705407,
      "end": 1790452709625
    },
    {
      "title": "2. Wait for Backup ready: On\nAll circuits are off. Waiting time shortened.",
      "start": 1790452730996,
      "end": 1790452734164
    },
    {
      "title": "3. Restore only the circuit you need\nClick Run beside Restore - here, Laundry Dryer.",
      "start": 1790452751455,
      "end": 1790452756043
    },
    {
      "title": "4. Turn on the appliance\nCircuit power is On; now switch on Virtual Dryer.",
      "start": 1790452792243,
      "end": 1790452796903
    },
    {
      "title": "5. Check the power readings\nBattery output: 5,000 W. Grid import: 0 W.",
      "start": 1790452816968,
      "end": 1790452820638
    },
    {
      "title": "6. The budget blocks oversized combinations\nTry restoring Garage while Laundry is reserved.",
      "start": 1790452820906,
      "end": 1790452825986
    },
    {
      "title": "The restore is refused - check Notifications\n5,001 W + 5,760 W exceeds the 10,500 W budget.",
      "start": 1790452834630,
      "end": 1790452838851
    },
    {
      "title": "7. Free capacity for a different circuit\nTurn the Laundry SPAN breaker off.",
      "start": 1790452858755,
      "end": 1790452863270
    },
    {
      "title": "8. Finish the outage\nTurn Grid outage - battery backup off.",
      "start": 1790452883323,
      "end": 1790452888422
    },
    {
      "title": "9. Restore grid supply\nClick Run beside Restore all circuit supplies.",
      "start": 1790452888423,
      "end": 1790452892868
    },
    {
      "title": "10. Reset the starting state\nVirtual Devices > Reset realistic household > Run.",
      "start": 1790453062422,
      "end": 1790453066118
    },
    {
      "title": "Ready to run again\nGrid outage is off. Battery output is 0 W.",
      "start": 1790453079436,
      "end": 1790453083137
    }
  ]
