# Optional overrides for docker compose. No .env file is needed for the default lab.
APP_PORT=5173
LAB_HA_PORT=8123
LAB_PANEL_PORT=18080
LAB_HEALTH_PORT=18081
# Outage risk model API (baselayer_model/api), published on localhost only.
MODEL_PORT=8000
# Home Assistant is available on the LAN by default; use 127.0.0.1 for host only.
LAB_BIND_ADDRESS=0.0.0.0

# To use your own Clerk application, set BOTH of these public settings.
# The defaults in compose.yaml use Base Layer's shared development application.
# CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
