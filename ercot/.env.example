# Copy to ercot/.env (gitignored) after registering at
# https://apiexplorer.ercot.com/

ERCOT_USERNAME=you@example.com
ERCOT_PASSWORD=your-api-explorer-password
# Primary key of the "Public API" subscription (/api/public-reports)
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=your-public-api-primary-key
# Primary key of the "Energy Storage Resource (ESR) API" subscription (/api/public-data)
ERCOT_ESR_API_SUBSCRIPTION_KEY=your-esr-api-primary-key
